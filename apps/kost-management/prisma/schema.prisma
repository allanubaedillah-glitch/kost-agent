generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Owner {
  id                    String     @id @default(uuid())
  email                 String     @unique
  passwordHash          String
  fullName              String
  phoneNumber           String
  subscriptionStatus    String     @default("ACTIVE") // ACTIVE, GRACE_PERIOD, EXPIRED, SUSPENDED
  subscriptionExpiresAt DateTime?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
  properties            Property[]

  @@map("owners")
}

model Property {
  id                   String            @id @default(uuid())
  ownerId              String
  owner                Owner             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name                 String
  slug                 String            @unique
  address              String
  city                 String
  district             String
  latitude             Float?
  longitude            Float?
  description          String?
  genderType           String            @default("MIXED") // MALE, FEMALE, MIXED
  generalFacilities    String            // JSON Array: ["Wi-Fi", "Parkir Mobil"]
  photos               String            // JSON Array: URLs
  contactPhone         String
  whatsappNumber       String
  requirementsSchema   String            // JSON: standard_presets, custom_checkboxes, notes (ADR-009)
  paymentBankName      String
  paymentAccountNumber String
  paymentAccountHolder String
  paymentQrisUrl       String?
  partnershipStatus    String            @default("NONE") // NONE, WAITING_REVIEW, APPROVED, REJECTED, SUSPENDED
  rejectionReason      String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  rooms                Room[]
  tenants              Tenant[]
  inboundBookings      InboundBooking[]
  operationalNotes     OperationalNote[]

  @@index([ownerId])
  @@index([city])
  @@map("properties")
}

model Room {
  id               String            @id @default(uuid())
  propertyId       String
  property         Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  roomNumber       String
  roomType         String            @default("PRIVATE") // PRIVATE, SHARED
  sizeSqm          Float?
  facilities       String            // JSON Array: ["AC", "Kamar Mandi Dalam"]
  photos           String            // JSON Array: URLs
  monthlyPrice     Float             // Tarif per slot per bulan (ADR-004)
  totalCapacity    Int               @default(1) // Total slot/orang (ADR-010)
  occupiedSlots    Int               @default(0)
  reservedSlots    Int               @default(0) // Slot yang di-hold transaksi aktif (ADR-008)
  status           String            @default("AVAILABLE") // AVAILABLE, MAINTENANCE
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  reservations     RoomReservation[]
  tenants          Tenant[]
  inboundBookings  InboundBooking[]

  @@unique([propertyId, roomNumber])
  @@index([propertyId])
  @@map("rooms")
}

model RoomReservation {
  id                 String   @id @default(uuid())
  roomId             String
  room               Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  bookingReferenceId String
  slotsCount         Int
  status             String   @default("HOLD") // HOLD, CONFIRMED, RELEASED
  expiresAt          DateTime // T + 60 menit
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([roomId])
  @@index([bookingReferenceId])
  @@index([expiresAt])
  @@map("room_reservations")
}

model Tenant {
  id               String     @id @default(uuid())
  propertyId       String
  property         Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  roomId           String
  room             Room       @relation(fields: [roomId], references: [id], onDelete: Cascade)
  fullName         String
  phoneNumber      String
  idCardNumber     String?
  emergencyContact String?
  startDate        DateTime
  dueDate          DateTime
  monthlyRent      Float
  status           String     @default("ACTIVE") // ACTIVE, CHECKED_OUT
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  rentBills        RentBill[]

  @@index([propertyId])
  @@index([roomId])
  @@map("tenants")
}

model RentBill {
  id           String    @id @default(uuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  billPeriod   String    // Contoh: "2026-11"
  dueDate      DateTime
  amount       Float
  status       String    @default("UNPAID") // UNPAID, PAID, OVERDUE
  paidAt       DateTime?
  paymentNotes String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([tenantId])
  @@map("rent_bills")
}

model InboundBooking {
  id                  String    @id @default(uuid())
  propertyId          String
  property            Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  roomId              String
  room                Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  kostagentBookingId  String    @unique
  customerName        String
  customerPhone       String
  slotsCount          Int
  durationMonths      Int
  startDate           DateTime
  endDate             DateTime
  totalAmount         Float
  occupantsData       String    // JSON Array data penghuni
  paymentProofUrl     String
  status              String    @default("PAYMENT_SUBMITTED") // PAYMENT_SUBMITTED, ACCEPTED, REJECTED, CHECKED_IN, CANCELLED
  rejectionReason     String?
  refundBankName      String?
  refundAccountNumber String?
  refundAccountHolder String?
  refundStatus        String    @default("NONE") // NONE, PENDING, COMPLETED
  refundTransferredAt DateTime?
  verifiedAt          DateTime?
  checkedInAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([propertyId])
  @@index([roomId])
  @@map("inbound_bookings")
}

model OperationalNote {
  id          String    @id @default(uuid())
  propertyId  String
  property    Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  title       String
  category    String    @default("REMINDER") // CLEANING, MAINTENANCE, REMINDER
  targetDate  DateTime?
  isCompleted Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([propertyId])
  @@map("operational_notes")
}
