# ==============================================================================
# KOST MANAGEMENT ENVIRONMENT VARIABLES (Vercel Project 2 & Supabase Project 2)
# ==============================================================================

# 1. Supabase PostgreSQL Connection Strings (Dari Project Settings -> Database)
# Transaction Connection Pooler (Port 6543) - Wajib untuk Serverless Vercel
DATABASE_URL="postgresql://postgres.[YOUR-KM-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct Connection (Port 5432) - Digunakan untuk prisma db push / migrasi
DIRECT_URL="postgresql://postgres.[YOUR-KM-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# 2. Integrasi Cross-Service ke KostAgent (API & Webhook Handshake)
# Di local: http://localhost:3000/api/v1
# Di Vercel production: https://kost-agent.vercel.app/api/v1
KOST_AGENT_API_URL="https://kost-agent.vercel.app/api/v1"

# 3. Kredensial Keamanan Webhook & Port (Opsional)
HMAC_WEBHOOK_SECRET="super-secret-hmac-sha256-key-golden-tiket-2026"
KM_PORT=4000
