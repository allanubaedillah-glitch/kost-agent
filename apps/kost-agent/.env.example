# ==============================================================================
# KOSTAGENT ENVIRONMENT VARIABLES (Vercel Project 1 & Supabase Project 1)
# ==============================================================================

# 1. Supabase PostgreSQL Connection Strings (Dari Project Settings -> Database)
# Transaction Connection Pooler (Port 6543) - Wajib untuk Serverless Vercel
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct Connection (Port 5432) - Digunakan untuk prisma db push / migrasi
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# 2. Supabase Storage (Untuk Upload Bukti Pembayaran Customer ke Bucket 'receipts')
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJh...[YOUR-SUPABASE-SERVICE-ROLE-KEY]"
SUPABASE_STORAGE_BUCKET="receipts"

# 3. Integrasi Cross-Service ke Kost Management (API & Webhook Handshake)
# Di local: http://localhost:4000/api/v1
# Di Vercel production: https://kost-management.vercel.app/api/v1
KOST_MANAGEMENT_API_URL="https://kost-management.vercel.app/api/v1"

# 4. Kredensial Keamanan Webhook & Port (Opsional)
HMAC_WEBHOOK_SECRET="super-secret-hmac-sha256-key-golden-tiket-2026"
KA_PORT=3000
